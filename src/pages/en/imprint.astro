---
import LegalPage from '../../components/LegalPage.astro';
import { OPERATOR as o } from '../../site';
---
<LegalPage lang="en" title="Imprint" other="/impressum/">
  <p>The legally binding version is the <a class="link" href="/impressum/">German Impressum</a>.</p>
  <h2>Operator</h2>
  <p>{o.name}<br />{o.street}<br />{o.city}</p>
  <p>Represented by: {o.representative.replace('Direktor', 'Director')}</p>
  <p>Company register: {o.register}</p>
  <p>VAT ID: {o.vat}</p>
  <h2>Contact</h2>
  <p>Email: {o.email}</p>
  <h2>Booking</h2>
  <p>The holiday house is let through the agency “Ferien an der Nordsee”. Their terms and conditions apply to all bookings.</p>
</LegalPage>
