---
interface Props {
  name: string;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { name, alt, sizes = '(min-width: 900px) 50vw, 100vw', eager = false, class: cls } = Astro.props;
const srcset = name === 'hero'
  ? `/img/hero-800.webp 800w, /img/hero-1600.webp 1600w, /img/hero-2400.webp 2400w`
  : `/img/${name}-800.webp 800w, /img/${name}-1600.webp 1600w`;
---
<img
  class={cls}
  src={`/img/${name}-1600.webp`}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : undefined}
/>
